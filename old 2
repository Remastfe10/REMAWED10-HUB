<script>
const grid = document.getElementById('grid');
const search = document.getElementById('search');

function openUrl(card) {
  const input = card.querySelector('.slot-url');
  let url = input.value.trim();

  if (!url) return alert('Inserisci prima un link.');

  if (!/^https?:\/\//i.test(url)) url = 'https://' + url;

  window.open(url, '_blank', 'noopener,noreferrer');
}

document.querySelectorAll('.go').forEach(btn => {
  btn.addEventListener('click', () => openUrl(btn.closest('.slot')));
});

search.addEventListener('input', () => {
  const q = search.value.toLowerCase().trim();

  document.querySelectorAll('.slot').forEach(card => {
    card.style.display = card.innerText.toLowerCase().includes(q) ? '' : 'none';
  });
});

document.querySelectorAll('.slot').forEach((card, i) => {
  const t = card.querySelector('.slot-title');
  const u = card.querySelector('.slot-url');

  t.value = localStorage.getItem('slotTitle' + i) || t.value;
  u.value = localStorage.getItem('slotUrl' + i) || u.value;

  t.addEventListener('input', () => localStorage.setItem('slotTitle' + i, t.value));
  u.addEventListener('input', () => localStorage.setItem('slotUrl' + i, u.value));
});
</script>

